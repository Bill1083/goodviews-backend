# Copy to .env and fill in. Never commit .env.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me

# TMDB — get from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Supabase — Project Settings → API → service_role key (NEVER expose to the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis — optional locally (caching silently no-ops without it)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Taste stats + Wrapped (all optional; defaults shown)
# Month-day (MM-DD, UTC) when the current year's Wrapped unlocks. Past years are always open.
WRAPPED_UNLOCK_MONTH_DAY=12-01
# LOCAL DEV ONLY: set to 1 to play the current year's Wrapped before the unlock date.
WRAPPED_PREVIEW_UNLOCK=0
# Minimum non-onboarding ratings in a year before a Wrapped is generated.
WRAPPED_MIN_FILMS=5
# Redis TTLs (seconds) for computed dashboard / Wrapped payloads.
STATS_DASHBOARD_TTL_SECONDS=3600
STATS_WRAPPED_TTL_SECONDS=86400
